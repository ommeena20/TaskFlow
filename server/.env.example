PORT=5000
# Local MongoDB, or paste your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/taskflow
# Use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
